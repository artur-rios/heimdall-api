<Project>

  <!--
    The settings shared with src/ come from Directory.Build.shared.props at the repository root,
    because MSBuild stops at the nearest file and the test projects never see the one under src/.

    Scoped to tests/ on purpose: MSBuild walks up from each project to the nearest
    Directory.Build.props, and every test project lives under this directory while no production
    project does. Nothing under src/ is affected.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.shared.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)default.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
