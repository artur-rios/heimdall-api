meta {
  name: List a scope's Users
  type: http
  seq: 7
}

get {
  url: {{host}}/api/scopes/{{scopeId}}/persons?pageNumber=1&pageSize=20&includeDeleted=false
  body: none
  auth: inherit
}

docs {
  UC-07. System Admin, or the Scope Admin who owns the scope.

  Owners are not Users of the scope and do not appear here.
}
