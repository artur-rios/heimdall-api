meta {
  name: Read one person
  type: http
  seq: 6
}

get {
  url: {{host}}/api/persons/{{personId}}?includeDeleted=false
  body: none
  auth: inherit
}

docs {
  UC-07. Any authenticated caller — a person may always read themselves.
  ownedScopeIds lists every scope the person owns for a System Admin or the person themselves; a Scope Admin reading somebody else sees only the scopes they own too (FR-PE-19).
}
