meta {
  name: List credentials
  type: http
  seq: 8
}

get {
  url: {{host}}/api/scopes/{{scopeId}}/applications/{{applicationId}}/credentials
  body: none
  auth: inherit
}

docs {
  UC-54. System Admin, or the Scope Admin who owns the application.

  Newest first, each with live, createdAt, expiresAt, revokedAt and lastUsedAt. Never the secret or its hash.
}
