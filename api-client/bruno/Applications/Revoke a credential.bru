meta {
  name: Revoke a credential
  type: http
  seq: 11
}

delete {
  url: {{host}}/api/scopes/{{scopeId}}/applications/{{applicationId}}/credentials/{{credentialId}}
  body: none
  auth: inherit
}

docs {
  UC-55. System Admin, or the Scope Admin who owns the application.

  The secret stops being exchanged at once, and every token already issued from it fails 'Check an application token'.
}
