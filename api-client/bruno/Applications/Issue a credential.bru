meta {
  name: Issue a credential
  type: http
  seq: 7
}

post {
  url: {{host}}/api/scopes/{{scopeId}}/applications/{{applicationId}}/credentials
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "expiresAt": "2030-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("credentialId", res.body.data.id);
    bru.setEnvVar("applicationSecret", res.body.data.secret);
  }
}

docs {
  UC-53. System Admin, or the Scope Admin who owns the application. The secret is in this response only.

  The post-response script stores it as applicationSecret, together with credentialId. An application holds at most two live credentials: a third is refused with 409 until one is revoked. expiresAt is optional; a value without an offset is read as UTC.
}
