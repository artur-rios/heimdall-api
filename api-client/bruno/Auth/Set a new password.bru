meta {
  name: Set a new password
  type: http
  seq: 4
}

post {
  url: {{host}}/api/auth/password-reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "paste-the-reset-token-here",
    "newPassword": "ChangeMe2!"
  }
}

docs {
  UC-13. Anonymous.

  The token arrives by email. With the logging sender configured (EMAIL_DELIVERY=Logging) it is written to the API's log instead of being sent, which is where to copy it from locally.
}
