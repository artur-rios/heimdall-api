meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.body.data && res.body.data.token) {
    bru.setEnvVar("token", res.body.data.token);
  } else if (res.body.data && res.body.data.challengeToken) {
    bru.setEnvVar("challengeToken", res.body.data.challengeToken);
  }
}

docs {
  UC-11. Anonymous. A ScopeAdmin or SystemAdmin sends credentials alone.

  Run this first: the post-response script stores the token every other request sends. When the account has 2FA active the answer is a challenge token instead, which is stored under challengeToken for 'Verify two-factor' to redeem.

  Rate-limited to 10 requests per minute per IP, like every anonymous endpoint here.
}
