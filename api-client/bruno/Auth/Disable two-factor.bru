meta {
  name: Disable two-factor
  type: http
  seq: 12
}

post {
  url: {{host}}/api/auth/2fa/disable
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{adminPassword}}",
    "code": "000000"
  }
}

docs {
  UC-39. Authenticated.

  Requires the current password *and* a second factor — as hard to satisfy as a login. Send either code or recoveryCode.
}
