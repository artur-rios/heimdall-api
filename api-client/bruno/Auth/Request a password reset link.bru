meta {
  name: Request a password reset link
  type: http
  seq: 3
}

post {
  url: {{host}}/api/auth/password-recovery
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}"
  }
}

docs {
  UC-12. Anonymous.

  Always answers 200, whether or not the address belongs to anyone, so it cannot be used to enumerate accounts. A User sends scopeId as well; an administrator sends the email alone.
}
