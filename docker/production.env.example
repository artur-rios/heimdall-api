# Production environment -- on the VPS, deployed by yggdrasil (github.com/artur-rios/yggdrasil),
# against the PostgreSQL instance installed there. Always on. Jenkins deploys a release when its
# release/x.y.z -> main pull request has passed every check, then merges and tags it.
#
# Fill in a copy at /etc/yggdrasil/production/heimdall-api.env on the VPS -- never commit it.
# example.com stands for your domain. API_PORT and COMPOSE_PROJECT_NAME have no place here:
# yggdrasil's stacks/heimdall-api.proxy.yml removes the host port, and the project is named
# heimdall-api-production.

# The host names Traefik routes to this API, both covered by the *.example.com wildcard certificate:
# its own, for the mobile and desktop clients, and the web UI's, under which it serves its /api/
# routes (stacks/heimdall-api.proxy.yml).
PUBLIC_HOST=heimdall-api.example.com
UI_HOST=heimdall.example.com

# No Swagger, no developer exception page, no EF parameter logging -- and the API refuses to start
# without the Mailgun variables below, rather than silently swallowing every e-mail it owes a user.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL on the VPS itself: host.docker.internal resolves through extra_hosts to the bridge
# gateway. The instance serves every environment on the VPS, each with its own database and its own
# login, so no environment can read another's data; production keeps the database it has always
# had, heimdall. If the instance ever moves to another machine, put its private address here
# instead and keep the traffic off the public interface.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=heimdall
DB_USER=
DB_PASSWORD=
# For an instance on another host, require TLS: "SSL Mode=Require;Trust Server Certificate=true"
# (drop Trust Server Certificate once the server presents a certificate the container can verify).
DB_CONNECTION_EXTRA=
# heimdall-ui reaches the API under its own origin (UI_HOST/api/), so it needs no entry here. List
# any other browser origin that calls PUBLIC_HOST directly (scheme + host + port, exactly as the
# browser sends them); with no entry the same-origin policy refuses every cross-origin request,
# which is the safe default for an API that hands out and honours credentials.
HEIMDALL_CORS_ALLOWED_ORIGINS=

# The reverse proxy in front of the API, as the container sees it: comma-separated addresses and/or
# CIDR networks. X-Forwarded-For / X-Forwarded-Proto are believed from these only, so the rate limiter
# partitions on the real caller and the request log records the real caller's address. Left empty,
# every request appears to come from the proxy -- one rate-limit bucket for the whole internet.
#
# Traefik runs in a container on yggdrasil's shared edge network, and Docker allocates its networks
# from 172.16.0.0/12: the range covers edge whatever subnet it was given, and survives Traefik's
# container being recreated, which changes its address. Never a range a caller can originate from:
# anything listed here can name any address it likes.
HEIMDALL_TRUSTED_PROXIES=172.16.0.0/12

# Its own secret, never the one used in another environment: whoever holds it can mint a token for
# any user. fortuna-api in production verifies heimdall's tokens with the same value
# (FORTUNA_AUTH_TOKEN_SECRET). To generate one: openssl rand -base64 48
HEIMDALL_AUTH_TOKEN_SECRET=

# The key a rotation has moved off but not yet withdrawn. Tokens signed with it stay valid
# while it is set, so replacing the secret above does not sign everybody out. Clear it one
# token lifetime after the rotation. Leave empty when not rotating.
HEIMDALL_AUTH_TOKEN_SECRET_PREVIOUS=
HEIMDALL_AUTH_TOKEN_ISSUER=heimdall
HEIMDALL_AUTH_TOKEN_AUDIENCE=heimdall
HEIMDALL_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600

# How many Argon2id password derivations run at once, process-wide. Each wants about 600 MB,
# so this is a memory budget: 4 is roughly 2.4 GB. Beyond it, callers wait and then get a 503.
HEIMDALL_AUTH_MAX_CONCURRENT_PASSWORD_HASHES=4

# Seeded on first start only, while the database holds no system administrator. Change the password
# after that first sign-in -- it stays in this file otherwise.
HEIMDALL_MASTER_USER_NAME=
HEIMDALL_MASTER_USER_EMAIL=
HEIMDALL_MASTER_USER_PASSWORD=

# Public URLs of heimdall-ui, as the recipient will follow them from their e-mail client.
HEIMDALL_EMAIL_VERIFICATION_URL=https://heimdall.example.com/verify-email
HEIMDALL_EMAIL_VERIFICATION_TOKEN_EXPIRATION_IN_SECONDS=
HEIMDALL_PASSWORD_RESET_URL=https://heimdall.example.com/password-reset
HEIMDALL_PASSWORD_RESET_TOKEN_EXPIRATION_IN_SECONDS=

# Required: startup fails without the key and the domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_VERSION=

HEIMDALL_GOOGLE_CLIENT_IDS=

# Set to false to apply migrations as a separate deploy step instead -- and necessarily so if this
# environment ever runs more than one replica, which must not race each other at start-up.
HEIMDALL_RUN_MIGRATIONS=true

# --- Data protection ------------------------------------------------------------------
# Every value below has a default that enforces the published retention schedule, so leaving
# them blank is a supported choice rather than an omission. See
# docs/requirements/Data Retention Schedule Document.md.

# Put "SSL Mode=Require" (or VerifyCA / VerifyFull) in DB_CONNECTION_EXTRA above, then set this
# to true so the API refuses to start if it is ever lost. Left blank it only warns.
HEIMDALL_DATA_REQUIRE_TLS=

# Retention periods, in days unless named otherwise. Blank = the published default.
HEIMDALL_RETENTION_TOKEN_GRACE_DAYS=
HEIMDALL_RETENTION_ERASURE_DEADLINE_DAYS=
HEIMDALL_RETENTION_DELETION_WINDOW_DAYS=
HEIMDALL_RETENTION_AUDIT_ACTOR_DAYS=
HEIMDALL_RETENTION_LOG_DAYS=

# Scheduled passes. Blank = on. Setting any to false leaves personal data past its retention
# period and is logged as a warning at start-up.
HEIMDALL_RETENTION_PURGE_ENABLED=
HEIMDALL_RETENTION_ANONYMISATION_ENABLED=
HEIMDALL_RETENTION_AUDIT_PSEUDONYMISATION_ENABLED=
HEIMDALL_RETENTION_PURGE_INTERVAL_MINUTES=
HEIMDALL_RETENTION_PURGE_BATCH_SIZE=

# Where the log files go. Blank = ./logs. scripts/security_signals.py reads the same variable
# to find the SECURITY_SIGNAL lines it collects.
HEIMDALL_LOG_DIRECTORY=

# Security signal detection. Signals reach the log with a SECURITY_SIGNAL marker.
# scripts/security_signals.py collects them on a schedule and mails what is new — set
# HEIMDALL_SIGNAL_ALERT_TO in that job's environment, not here; the API does not send them.
HEIMDALL_MONITORING_ENABLED=
HEIMDALL_MONITORING_WINDOW_MINUTES=
HEIMDALL_MONITORING_REFUSAL_THRESHOLD=
HEIMDALL_MONITORING_LOCKOUT_THRESHOLD=

# --- Metrics -----------------------------------------------------------------------------
# Prometheus scrape endpoint, served at /metrics on this port only. Blank = 9464, 0 = off.
# yggdrasil's Prometheus scrapes heimdall-api.production:9464 over its telemetry network -- never
# publish the port, and never route Traefik to it: the endpoint is told apart by the port a
# connection arrives on, precisely because Traefik forwards a Host header the client chose.
# yggdrasil's overlay gives Traefik the service port explicitly
# (traefik.http.services.<name>.loadbalancer.server.port=8080). A value other than 9464 also
# needs adding to ASPNETCORE_HTTP_PORTS, which the image sets to 8080;9464.
HEIMDALL_METRICS_PORT=
