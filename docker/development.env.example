# Development environment -- Docker inside the WSL Ubuntu distro, against the PostgreSQL instance
# installed in that same distro. Copy to docker/development.env and fill in; that copy is gitignored.
#
#     docker compose --env-file docker/development.env up -d --build
#
# DB_HOST depends on which engine runs the container, and inside a WSL distro the two options do not
# behave the same:
#
#   * Docker Engine installed in the distro (apt install docker-ce) -- the containers run in Ubuntu
#     itself, so host.docker.internal resolves through extra_hosts to the bridge gateway (172.17.0.1)
#     and reaches the Postgres installed in that distro. Leave the value below as it is.
#
#     This is the setup to prefer here: it is the only one where "runs inside the Ubuntu distro" is
#     literally true, and the only one where DB_HOST is a constant.
#
#   * Docker Desktop with WSL integration (what `docker` currently resolves to in the distro -- the
#     CLI is a symlink into /mnt/wsl/docker-desktop) -- the containers run in Docker Desktop's own
#     VM, not in Ubuntu, and host.docker.internal points at the *Windows* host. Postgres inside the
#     distro is then reachable only at the distro's own address, which WSL reassigns on restart:
#
#         DB_HOST=$(hostname -I | awk '{print $1}') \
#             docker compose --env-file docker/development.env up -d --build
#
#     A value from the shell wins over the one in this file, so nothing here needs editing per boot.
#
# Either way, confirm before the first run:
#     docker run --rm --add-host host.docker.internal:host-gateway alpine \
#         sh -c 'nc -z -w 3 <DB_HOST> 5432 && echo reachable || echo unreachable'

COMPOSE_PROJECT_NAME=heimdall-development

ASPNETCORE_ENVIRONMENT=Development

API_PORT=8080

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=heimdall_development
DB_USER=
DB_PASSWORD=
DB_CONNECTION_EXTRA=

# Its own secret -- a shared environment must not be able to mint tokens the others accept.
HEIMDALL_AUTH_TOKEN_SECRET=
HEIMDALL_AUTH_TOKEN_ISSUER=heimdall
HEIMDALL_AUTH_TOKEN_AUDIENCE=heimdall
HEIMDALL_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600

HEIMDALL_MASTER_USER_NAME=
HEIMDALL_MASTER_USER_EMAIL=
HEIMDALL_MASTER_USER_PASSWORD=

# The front end this environment serves, reachable from wherever its users are -- the links are
# followed from an e-mail client, so localhost only works for someone on the machine itself.
HEIMDALL_EMAIL_VERIFICATION_URL=
HEIMDALL_EMAIL_VERIFICATION_TOKEN_EXPIRATION_IN_SECONDS=
HEIMDALL_PASSWORD_RESET_URL=
HEIMDALL_PASSWORD_RESET_TOKEN_EXPIRATION_IN_SECONDS=

# Optional here: unset, verification and reset e-mails are logged rather than sent. Set them to
# exercise real delivery before Production does.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_VERSION=

HEIMDALL_GOOGLE_CLIENT_IDS=

HEIMDALL_RUN_MIGRATIONS=true
