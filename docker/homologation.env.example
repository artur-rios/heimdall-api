# Homologation environment -- on the VPS, deployed by yggdrasil (github.com/artur-rios/yggdrasil),
# against the PostgreSQL instance installed there. Jenkins deploys every push of a release/x.y.z
# branch, so this is the release candidate production is about to get. On demand: on the VPS,
# scripts/ygg.sh env start homologation turns it on and env stop homologation off again; a deploy
# leaves a stopped environment stopped.
#
# Fill in a copy at /etc/yggdrasil/homologation/heimdall-api.env on the VPS -- never commit it.
# example.com stands for your domain. API_PORT and COMPOSE_PROJECT_NAME have no place here:
# yggdrasil's stacks/heimdall-api.proxy.yml removes the host port, and the project is named
# heimdall-api-homologation.

# The host names Traefik routes to this API, both covered by the *.example.com wildcard certificate:
# its own, for the mobile and desktop clients, and the web UI's, under which it serves its /api/
# routes (stacks/heimdall-api.proxy.yml).
PUBLIC_HOST=heimdall-api-hml.example.com
UI_HOST=heimdall-hml.example.com

# Staging: not Development -- no Swagger, no developer exception page -- and not Production, so
# verification and reset e-mails are logged instead of sent and no Mailgun account is needed. EF
# diagnostics, which log parameter values, are off here because the environment serves a public
# host (see below). The logged e-mails still carry personal data: test with made-up people, never
# with production's. Set Production instead (and the Mailgun variables) if homologation must send
# real e-mail.
ASPNETCORE_ENVIRONMENT=Staging

# On an instance that serves a public host, the diagnostics Staging asks for -- EF parameter
# logging and detailed errors -- stay off unless this is true (NFR-28); start-up says which, once.
# Set this to true only to keep them on, and only while the environment holds made-up people
# (Operations & Infrastructure Document §0.2).
HEIMDALL_ALLOW_SENSITIVE_DIAGNOSTICS=

# PostgreSQL on the VPS itself: host.docker.internal resolves through extra_hosts to the bridge
# gateway. The instance serves every environment on the VPS, each with its own database and its own
# login -- heimdall_homologation_svc here -- so no environment can read another's data. The README's
# "Deploy with Docker" section shows how to create both, and the pg_hba.conf rule they need.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=heimdall_homologation
DB_USER=
DB_PASSWORD=
# Appended verbatim to the connection string, e.g. "SSL Mode=Require;Trust Server Certificate=true".
DB_CONNECTION_EXTRA=
# heimdall-ui reaches the API under its own origin (UI_HOST/api/), so it needs no entry here. List
# any other browser origin that calls PUBLIC_HOST directly (scheme + host + port, exactly as the
# browser sends them); with no entry the same-origin policy refuses every cross-origin request.
HEIMDALL_CORS_ALLOWED_ORIGINS=

# Traefik runs in a container on yggdrasil's shared edge network, and Docker allocates its networks
# from 172.16.0.0/12 -- the range covers edge whatever subnet it was given, and survives Traefik's
# container being recreated. X-Forwarded-For / X-Forwarded-Proto are believed from it only, so the
# rate limiter and the request log see the real caller. Left empty, every request appears to come
# from Traefik -- one rate-limit bucket for the whole internet.
HEIMDALL_TRUSTED_PROXIES=172.16.0.0/12

# Its own key, never the one used in another environment: whoever holds it can mint a token for
# any user. Only heimdall holds it; consumers verify with the public keys at
# /.well-known/jwks.json.
# The ES256 private key every token is signed with. Required: the API refuses to start without a
# P-256 private key here. Generate it with
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out signing.pem
# and set the value to the one-line base64 of that PKCS#8 PEM:
#   base64 -w0 signing.pem
HEIMDALL_AUTH_SIGNING_KEY=

# The key a rotation has moved off but not yet withdrawn, in the same format. Its public half stays
# published and its tokens stay valid, but it never signs. Set it to the former current key when
# you change the key above; clear it one token lifetime later. Leave empty when not rotating.
HEIMDALL_AUTH_SIGNING_KEY_PREVIOUS=

# The former HS256 secret. Optional: while it is set, HS256 tokens issued before 3.0.0 are still
# accepted (none is issued). Keep it until every consumer verifies through the key set and the
# longest token lifetime has passed, then remove it. Do not hand it to new consumers. While set,
# it is held to a 32-byte ASCII minimum, or the API refuses to start.
HEIMDALL_AUTH_TOKEN_SECRET=

# The secret a legacy rotation moved off. Same rules; refused at start-up when set without the
# secret above. Leave empty.
HEIMDALL_AUTH_TOKEN_SECRET_PREVIOUS=
HEIMDALL_AUTH_TOKEN_ISSUER=heimdall
HEIMDALL_AUTH_TOKEN_AUDIENCE=heimdall
HEIMDALL_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600

# Audience of the tokens applications obtain with their credentials. Required, and it must differ
# from HEIMDALL_AUTH_TOKEN_AUDIENCE: the API refuses to start otherwise.
HEIMDALL_APPLICATION_TOKEN_AUDIENCE=heimdall-applications
HEIMDALL_APPLICATION_TOKEN_EXPIRATION_IN_SECONDS=600

# How many Argon2id password derivations run at once, process-wide. Each wants about 600 MB,
# so this is a memory budget: 4 is roughly 2.4 GB. Beyond it, callers wait and then get a 503.
HEIMDALL_AUTH_MAX_CONCURRENT_PASSWORD_HASHES=4

# Seeded on first start only, while the database holds no system administrator. Its own
# credentials, not production's. Change the password after that first sign-in -- it stays in this
# file otherwise.
HEIMDALL_MASTER_USER_NAME=
HEIMDALL_MASTER_USER_EMAIL=
HEIMDALL_MASTER_USER_PASSWORD=

# Where the e-mails point the recipient: heimdall-ui in this environment.
HEIMDALL_EMAIL_VERIFICATION_URL=https://heimdall-hml.example.com/verify-email
HEIMDALL_EMAIL_VERIFICATION_TOKEN_EXPIRATION_IN_SECONDS=
HEIMDALL_PASSWORD_RESET_URL=https://heimdall-hml.example.com/password-reset
HEIMDALL_PASSWORD_RESET_TOKEN_EXPIRATION_IN_SECONDS=
HEIMDALL_ADMIN_EMAIL_COOLDOWN_IN_SECONDS=
HEIMDALL_SCOPE_INVITATION_LIFETIME_IN_SECONDS=

# Optional under Staging: unset, verification and reset e-mails are logged rather than sent.
# Required if ASPNETCORE_ENVIRONMENT above is changed to Production.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_VERSION=
# The sender: "Name <address>" or a bare address on the Mailgun domain. Unset, mail goes out
# from a bare postmaster@$MAILGUN_DOMAIN.
MAILGUN_FROM=Heimdall <no-reply@example.com>

HEIMDALL_GOOGLE_CLIENT_IDS=

# The release's migrations run here before they run in production, so a migration that fails
# fails here first. Set to false to apply them as a separate deploy step instead.
HEIMDALL_RUN_MIGRATIONS=true

# Optional: the connection string the entrypoint migrates with, when it should not be DB_USER's.
# Give it the role that owns the schema and DB_USER a role that owns nothing, and the API's own
# credentials can no longer alter the tables or the audit triggers (Threat Model TH-18; the
# operations guide, "Database roles", has the SQL). A whole connection string, with the same
# Search Path the API's has (public, unless DB_SEARCH_PATH says otherwise), e.g.
#   Host=host.docker.internal;Port=5432;Database=heimdall_homologation;Username=heimdall_homologation_owner;Password=...;Search Path=public
# Empty, the entrypoint migrates as DB_USER, as before.
HEIMDALL_MIGRATIONS_CONNECTIONSTRING=

# --- Data protection ------------------------------------------------------------------
# Every value below has a default that enforces the published retention schedule, so leaving
# them blank is a supported choice rather than an omission. See
# docs/requirements/Data Retention Schedule Document.md.

# Put "SSL Mode=Require" (or VerifyCA / VerifyFull) in DB_CONNECTION_EXTRA above, then set this
# to true so the API refuses to start if it is ever lost. Left blank it only warns.
HEIMDALL_DATA_REQUIRE_TLS=

# Retention periods, in days unless named otherwise. Blank = the published default.
HEIMDALL_RETENTION_TOKEN_GRACE_DAYS=
HEIMDALL_RETENTION_ERASURE_DEADLINE_DAYS=
HEIMDALL_RETENTION_DELETION_WINDOW_DAYS=
HEIMDALL_RETENTION_AUDIT_ACTOR_DAYS=
HEIMDALL_RETENTION_LOG_DAYS=

# Scheduled passes. Blank = on. Setting any to false leaves personal data past its retention
# period and is logged as a warning at start-up.
HEIMDALL_RETENTION_PURGE_ENABLED=
HEIMDALL_RETENTION_ANONYMISATION_ENABLED=
HEIMDALL_RETENTION_AUDIT_PSEUDONYMISATION_ENABLED=
HEIMDALL_RETENTION_PURGE_INTERVAL_MINUTES=
HEIMDALL_RETENTION_PURGE_BATCH_SIZE=

# Where the log files go. Blank = ./logs. scripts/security_signals.py reads the same variable
# to find the SECURITY_SIGNAL lines it collects.
HEIMDALL_LOG_DIRECTORY=

# Security signal detection. Signals reach the log with a SECURITY_SIGNAL marker.
# scripts/security_signals.py collects them on a schedule and mails what is new — set
# HEIMDALL_SIGNAL_ALERT_TO in that job's environment, not here; the API does not send them.
HEIMDALL_MONITORING_ENABLED=
HEIMDALL_MONITORING_WINDOW_MINUTES=
HEIMDALL_MONITORING_REFUSAL_THRESHOLD=
HEIMDALL_MONITORING_LOCKOUT_THRESHOLD=

# --- Metrics -----------------------------------------------------------------------------
# Prometheus scrape endpoint, served at /metrics on this port only. Blank = 9464, 0 = off.
# yggdrasil's Prometheus scrapes heimdall-api.homologation:9464 over its telemetry network -- never
# publish the port, and never route Traefik to it: the endpoint is told apart by the port a
# connection arrives on, precisely because Traefik forwards a Host header the client chose.
# yggdrasil's overlay gives Traefik the service port explicitly
# (traefik.http.services.<name>.loadbalancer.server.port=8080). A value other than 9464 also
# needs adding to ASPNETCORE_HTTP_PORTS, which the image sets to 8080;9464.
HEIMDALL_METRICS_PORT=
